{
  "host": "127.0.0.1",
  "port": 8080,
  "check_interval_seconds": 10,
  "restart_cooldown_seconds": 30,
  "max_restart_attempts": 3,
  "stable_after_seconds": 60,
  "history_file": "servicewatch-history.jsonl",
  "history_retention_days": 30,
  "email": {
    "enabled": false,
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "use_tls": true,
    "username": "alerts@example.com",
    "password_env": "SERVICEWATCH_SMTP_PASSWORD",
    "from_addr": "alerts@example.com",
    "to_addrs": [
      "recipient1@example.com",
      "recipient2@example.com",
      "recipient3@example.com",
      "recipient4@example.com",
      "recipient5@example.com"
    ],
    "cooldown_seconds": 300,
    "notify_on": ["down", "recovered", "gave_up"]
  },
  "services": [
    { "name": "Themes", "label": "Themes", "auto_restart": true },
    { "name": "WSearch", "label": "Windows Search", "auto_restart": true },
    { "name": "SysMain", "label": "SysMain (Superfetch)", "auto_restart": true },
    { "name": "TrkWks", "label": "Distributed Link Tracking Client", "auto_restart": true },
    { "name": "stisvc", "label": "Windows Image Acquisition (WIA)", "auto_restart": true }
  ]
}