# FILE: .env.example
# ServiceWatch_V1
# Contact: oguejioforc@concordnc.gov
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
#   bash:        cp .env.example .env
#
# How these are consumed:
#   * app.py calls load_dotenv() at startup, so anything in .env is loaded
#     into os.environ automatically. Real environment variables take
#     precedence — values here do NOT override what's already set.
#   * notify.py reads the variable named by `email.password_env` in
#     config.json (default below) to authenticate against your SMTP server.

# ---------------------------------------------------------------------
# Config file location
# ---------------------------------------------------------------------
SERVICEWATCH_CONFIG=config.json

# ---------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------
# Set to 1 to force simulated services even on Windows.
SERVICEWATCH_MOCK=

# ---------------------------------------------------------------------
# SMTP password for email notifications
# ---------------------------------------------------------------------
# The variable name below must match `email.password_env` in config.json.
# Quote the value if it contains spaces (Gmail app passwords do).
SERVICEWATCH_SMTP_PASSWORD=

# End of File: .env.example